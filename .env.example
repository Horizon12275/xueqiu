XQ_COOKIE='xq_a_token=xxx; u=xxx; ...'
XQ_USER_AGENT='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36'

# Optional. Default is ./data
XQ_DATA_DIR='data'

# Optional. Comma-separated URL/path templates tried before built-in holding endpoints.
# Placeholders: {rb_id}, {cube_symbol}
# XQ_HOLDING_ENDPOINTS='/cubes/rebalancing/show.json?rb_id={rb_id},/cubes/rebalancing/show_origin.json?rb_id={rb_id}'

# Optional email notification. SMTP_PASSWORD is the QQ Mail authorization code,
# not your QQ login password.
SMTP_HOST='smtp.qq.com'
SMTP_PORT='465'
SMTP_SSL='true'
SMTP_USER='your_email@qq.com'
SMTP_PASSWORD='your_qq_mail_authorization_code'
EMAIL_FROM='your_email@qq.com'
EMAIL_TO='your_email@qq.com'
